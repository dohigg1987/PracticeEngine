{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "practiceengine-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "vars": {
    "APP_VERSION": "a288e35ed6d89b9b2a3d92197f92053e4572c042",
    "WEB_ORIGIN": "https://practiceengine-dev.pages.dev",
    "NEON_AUTH_URL": "https://ep-royal-dawn-axwaqz1u.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth",
    "RECURRENCE_EXECUTION_CONTEXTS": "[]"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "r2_buckets": [
    {
      "binding": "ARTEFACTS",
      "bucket_name": "practiceengine-dev-artefacts"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "642a6a36a3074b5e8875990bfa1485c9"
    }
  ]
}
