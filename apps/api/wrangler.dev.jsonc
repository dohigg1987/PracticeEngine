{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "practiceengine-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "vars": {
    "APP_VERSION": "6fe19a0eb935ba3b2c7b29763dd18423f800cf1e",
    "WEB_ORIGIN": "https://practiceengine-dev.pages.dev",
    "NEON_AUTH_URL": "https://ep-broad-firefly-zahbgsmb.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth",
    "RECURRENCE_EXECUTION_CONTEXTS": "[]"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "r2_buckets": [
    {
      "binding": "ARTEFACTS",
      "bucket_name": "practiceengine-dev-artefacts"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f155446f8013477db4bf22d597a0ec38"
    }
  ]
}
