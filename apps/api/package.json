{
  "name": "@uk-accounts/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "retention:inventory": "node --experimental-strip-types scripts/retention-inventory.ts",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:production-template": "node scripts/verify-production.mjs --config wrangler.production.example.jsonc --allow-placeholders"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "docx": "^9.5.1",
    "fflate": "^0.8.3",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
