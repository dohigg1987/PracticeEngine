# Public Neon Auth base URL from the Neon Console. Do not add database credentials or private keys.
VITE_NEON_AUTH_URL=

# Accounts API origin. Leave blank only when /v1 is routed on the same origin.
VITE_API_URL=

# Optional local-development fallback when tenant discovery is unavailable. Ignored in production builds.
VITE_TENANT_ID=
