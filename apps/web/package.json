{
  "name": "@uk-accounts/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:production": "node scripts/security-headers.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:headers": "node --test scripts/security-headers.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.6",
    "@fluentui/react-icons": "^2.0.337",
    "@neondatabase/neon-js": "^0.7.0-beta",
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "^5.8.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "vitest": "^4.1.10"
  }
}
